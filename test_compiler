#!/bin/bash
set -e

COMPILER=""
CHAPTER=""
STAGE=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        --chapter) CHAPTER="$2"; shift 2 ;;
        --stage)   STAGE="$2"; shift 2 ;;
        *)         COMPILER="$1"; shift ;;
    esac
done

if [ -z "$COMPILER" ] || [ -z "$CHAPTER" ] || [ -z "$STAGE" ]; then
    echo "Usage: $0 <compiler> --chapter <N> --stage <stage>"
    exit 1
fi

STAGE_FLAG="--${STAGE}"

TEST_DIR="tests/chapter_${CHAPTER}"
PASS=0
FAIL=0

echo "=== Valid programs ==="
for f in "$TEST_DIR"/valid/*.c; do
    [ -f "$f" ] || continue
    name=$(basename "$f")
    if "$COMPILER" "$STAGE_FLAG" "$f" > /dev/null 2>&1; then
        echo "  PASS: $name"
        PASS=$((PASS + 1))
    else
        echo "  FAIL: $name (expected success but failed)"
        FAIL=$((FAIL + 1))
    fi
done

echo "=== Invalid programs ==="
for f in "$TEST_DIR"/invalid_parse/*.c; do
    [ -f "$f" ] || continue
    name=$(basename "$f")
    if "$COMPILER" "$STAGE_FLAG" "$f" > /dev/null 2>&1; then
        echo "  FAIL: $name (expected failure but succeeded)"
        FAIL=$((FAIL + 1))
    else
        echo "  PASS: $name"
        PASS=$((PASS + 1))
    fi
done

echo "=== Results: $PASS passed, $FAIL failed ==="
[ "$FAIL" -eq 0 ]
